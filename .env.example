# Copy this file to .env and fill in at least HF_TOKEN.
#   cp .env.example .env
# Everything else has a working default (see app/config.py) and only needs
# to be uncommented/changed if you want to override it.

# ── HuggingFace Inference Providers (REQUIRED) ─────────────────────────────
# Create a token at https://huggingface.co/settings/tokens
# Fine-grained token: check only "Make calls to Inference Providers".
# This is the only scope needed — embeddings and reranking run locally and
# need no token at all.
HF_TOKEN=

# Only change this if you're pointing at a different OpenAI-compatible router.
# HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions

# ── OpenRouter (optional, paid models) ──────────────────────────────────────
# Only used by the Evaluation Lab, to benchmark paid frontier models (GPT-4o,
# Claude, Gemini, etc.) alongside the free HuggingFace chain above — chat
# never calls OpenRouter. Get a key at https://openrouter.ai/keys. Leave
# blank to disable; the Eval Lab still lists OpenRouter models in the
# dropdown but clearly flags that a key is needed before they'll run.
# Every call to a paid model is real, billed usage — this is worth double
# checking pricing at https://openrouter.ai/models before running a sweep.
OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Cosmetic attribution headers OpenRouter uses for their public leaderboard;
# safe to leave as-is.
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_SITE_NAME=RAG Lab

# ── Model failover cooldowns (seconds) ─────────────────────────────────────
# How long a model is skipped after each failure type before being retried.
# COOLDOWN_CREDIT_EXHAUSTED=3600
# COOLDOWN_RATE_LIMITED=45
# COOLDOWN_PROVIDER_ERROR=30

# ── Embeddings (local, free, no token needed) ──────────────────────────────
# Swap for BAAI/bge-base-en-v1.5 or BAAI/bge-large-en-v1.5 for higher
# accuracy at the cost of speed/RAM.
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# Instruction prefix bge-family models want prepended to the *query* only
# (passages are embedded without it). Only relevant if you swap EMBED_MODEL
# for a different embedding family with different (or no) prefix conventions.
# EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# ── Qdrant vector store — choose ONE mode ──────────────────────────────────
# memory (default): in-process, no persistence across restarts, no setup.
# local:            on-disk via embedded Qdrant. Set QDRANT_PATH.
# remote:           external Qdrant server or Qdrant Cloud. Set QDRANT_URL
#                    and, for Qdrant Cloud, QDRANT_API_KEY.
QDRANT_MODE=memory
# QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=raglab_chunks

# ── Storage paths ───────────────────────────────────────────────────────────
# DATA_DIR=./data
# DB_PATH=./data/raglab.db

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# HMAC signing key for session tokens. Auto-generated and persisted to
# data/.jwt_secret if left blank — fine for a single-machine dev run, but if
# you run more than one app server (or want the secret survive a wiped data
# dir) set an explicit value here. Must be at least 32 characters.
# JWT_SECRET=
# JWT_ISSUER=raglab
# JWT_TTL_SECONDS=43200

# Login brute-force throttle (per email, per process).
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=60

# ── Uploads ─────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=50

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Leave blank for
# same-origin only (the default, and safest — the app never sends "*").
# CORS_ORIGINS=
